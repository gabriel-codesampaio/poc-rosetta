PORT=3333

# Twilio (fase 4). Sem estas variáveis o webhook roda em dry-run: o turno aparece no /debug, mas nada é enviado.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Número do sandbox do WhatsApp no Twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública do webhook (ex.: https://abcd.ngrok-free.app/twilio/webhook). Ativa a validação de assinatura.
TWILIO_WEBHOOK_URL=
